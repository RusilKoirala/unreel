{
  "manifest_version": 3,
  "name": "Unreel: Hide Shorts, Reels & Feeds",
  "short_name": "Unreel",
  "version": "1.0.0",
  "description": "Hide YouTube Shorts, Instagram Reels and endless feeds, all day or during hours you set. Free and open source.",
  "minimum_chrome_version": "105",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Unreel",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.instagram.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
